{
    "name": "shopen/core",
    "type": "library",
    "autoload": {
        "psr-4": {
            "Shopen\\": "src/"
        }
    },

    "extra": {
        "laravel": {
            "providers": [
                "Shopen\\Providers\\ShopenServiceProvider"
            ]
        }
    },
    "require": {
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.10.1",
        "laravel/pint": "^1.13",
        "spatie/laravel-medialibrary": "^11.13",
        "openpayu/openpayu": "^2.3",
        "inertiajs/inertia-laravel": "^2.0",
        "tightenco/ziggy": "^2.5",
        "laravel/scout": "^10.16",
        "babenkoivan/elastic-scout-driver-plus": "^5.1",
        "babenkoivan/elastic-scout-driver": "^4.0",
        "fedeisas/laravel-mail-css-inliner": "^5.4",
        "laravel/socialite": "^5.23",
        "ext-libxml": "*"
    },
    "require-dev": {
        "orchestra/canvas": "^10.0"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
